flamong.lhsdev.info {
	# includeSubDomains 는 넣지 않는다. 같은 도메인의 포트폴리오(GitHub Pages)에 영향이 가지 않게
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	handle_path /api/* {
		reverse_proxy 127.0.0.1:3000
	}
	handle {
		root * /var/www/flamong
		# 빌드 파일은 이름이 내용 해시(Name Files As Hashes)라 오래 둬도 된다. index.html 은 매번 확인해 새 빌드 이름을 바로 받는다.
		# 캐시 지시가 없으면 Safari 가 예전 framework.js 와 새 wasm 을 섞어 로딩 중에 GLctx 오류가 났다(2026-11-03)
		@build path /Build/*
		header @build Cache-Control "public, max-age=31536000, immutable"
		@page not path /Build/*
		header @page Cache-Control "no-cache"
		# Unity Brotli 빌드: .br 파일에 압축 헤더와 원래 형식을 붙인다
		@br path *.br
		header @br Content-Encoding br
		@wasm path *.wasm.br
		header @wasm Content-Type application/wasm
		@js path *.js.br
		header @js Content-Type application/javascript
		file_server
	}
}
